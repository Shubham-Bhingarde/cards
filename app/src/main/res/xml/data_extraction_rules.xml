<?xml version="1.0" encoding="utf-8"?>
<!--
  Belt-and-suspenders with allowBackup=false: even if a future build enables
  backup, exclude everything so card data and the encrypted DB are never copied
  off-device by cloud backup or device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
